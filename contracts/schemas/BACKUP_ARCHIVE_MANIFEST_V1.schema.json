{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xueqing.local/contracts/backup-archive-manifest-v1.schema.json",
  "title": "Xueqing Backup Archive Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "archive_id",
    "created_at",
    "source",
    "consistency",
    "database",
    "storage",
    "security"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "archive_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "environment_id",
        "region",
        "source_commit",
        "migration_count",
        "migrations",
        "schema_fingerprint_sha256"
      ],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1 },
        "environment_id": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "migration_count": { "type": "integer", "minimum": 1 },
        "migrations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "schema_fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "boundary_id",
        "database_started_at",
        "database_finished_at",
        "objects_started_at",
        "objects_finished_at",
        "maximum_data_loss_window_seconds"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "quiesced-window",
            "deterministic-reconciliation"
          ]
        },
        "boundary_id": { "type": "string", "minLength": 1 },
        "database_started_at": { "type": "string", "format": "date-time" },
        "database_finished_at": { "type": "string", "format": "date-time" },
        "objects_started_at": { "type": "string", "format": "date-time" },
        "objects_finished_at": { "type": "string", "format": "date-time" },
        "maximum_data_loss_window_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "tool",
        "tool_version",
        "archive_relative_path",
        "byte_length",
        "sha256",
        "row_counts"
      ],
      "properties": {
        "format": { "const": "postgresql-custom" },
        "tool": { "const": "pg_dump" },
        "tool_version": { "type": "string", "minLength": 1 },
        "archive_relative_path": { "type": "string", "minLength": 1 },
        "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "row_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket_id",
        "private",
        "object_count",
        "objects"
      ],
      "properties": {
        "bucket_id": { "const": "teaching-attachments-v1" },
        "private": { "const": true },
        "object_count": { "type": "integer", "minimum": 0 },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "logical_object_locator",
              "archive_relative_path",
              "byte_length",
              "mime_type",
              "sha256"
            ],
            "properties": {
              "logical_object_locator": {
                "type": "string",
                "minLength": 1
              },
              "archive_relative_path": {
                "type": "string",
                "minLength": 1
              },
              "byte_length": {
                "type": "integer",
                "minimum": 1
              },
              "mime_type": {
                "enum": [
                  "image/jpeg",
                  "image/png",
                  "image/webp"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_encrypted",
        "encryption_scheme",
        "key_stored_separately",
        "production_material_in_public_ci"
      ],
      "properties": {
        "archive_encrypted": { "const": true },
        "encryption_scheme": { "type": "string", "minLength": 1 },
        "key_stored_separately": { "const": true },
        "production_material_in_public_ci": { "const": false }
      }
    }
  }
}
