{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xueqing.local/contracts/release-candidate-evidence-v1.schema.json",
  "title": "Xueqing Release Candidate Artifact Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "generated_at",
    "source_commit",
    "release_version",
    "platform",
    "workflow",
    "identity",
    "artifacts",
    "signing"
  ],
  "properties": {
    "contract": { "const": "release_candidate_evidence_v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "release_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "platform": { "enum": ["android", "windows"] },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "run_id", "run_attempt"],
      "properties": {
        "repository": { "const": "qbjsdsb/xueqing-native" },
        "run_id": { "type": ["string", "null"], "pattern": "^[0-9]+$" },
        "run_attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "identity": { "type": "object" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "sha256"],
        "properties": {
          "kind": { "enum": ["apk", "msix", "setup"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "certificate_sha256"],
      "properties": {
        "mode": { "enum": ["android-release-key", "signpath", "pfx"] },
        "certificate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
