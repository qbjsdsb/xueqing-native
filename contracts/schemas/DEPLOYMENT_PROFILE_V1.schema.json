{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xueqing.local/contracts/deployment-profile-v1.schema.json",
  "title": "Xueqing Deployment Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "profile_id",
    "environment_id",
    "trust_domain_id",
    "provider_id",
    "project_origin",
    "publishable_key",
    "required_edge_region",
    "capabilities",
    "source"
  ],
  "properties": {
    "contract": { "const": "deployment_profile_v1" },
    "profile_id": { "type": "string", "minLength": 3, "maxLength": 64 },
    "environment_id": { "type": "string", "minLength": 3, "maxLength": 64 },
    "trust_domain_id": { "type": "string", "minLength": 3, "maxLength": 96 },
    "provider_id": { "type": "string", "minLength": 2, "maxLength": 32 },
    "project_origin": { "type": "string", "format": "uri" },
    "publishable_key": { "type": "string", "minLength": 16, "maxLength": 2048 },
    "required_edge_region": { "type": "string", "minLength": 3, "maxLength": 64 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["auth", "database-rpc", "edge-functions", "private-storage"]
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "const": "qbjsdsb/xueqing-native" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  }
}
