<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xueqing.Windows.Views.TodayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="28,20,28,24"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                AutomationProperties.AutomationId="TodayHeading"
                FontSize="28"
                FontWeight="SemiBold"
                Text="今日" />
            <TextBlock
                AutomationProperties.AutomationId="TodaySurface"
                Opacity="0.68"
                Text="明确的待办教学行动，而不是未关闭问题的统计面板" />
            <TextBlock
                Opacity="0.62"
                Text="{Binding TodayStatusText}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Spacing="8">
            <TextBlock
                AutomationProperties.AutomationId="PendingLearningCaseRecoveryStatus"
                Opacity="0.66"
                Text="{Binding PendingLearningCaseRecoveryStatusText}"
                TextWrapping="Wrap" />

            <ItemsControl ItemsSource="{Binding PendingLearningCaseRecoveries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,8,8,10" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Opacity="0.72"
                                    Text="{Binding PrimaryActionText}"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Opacity="0.58" Text="{Binding StudentDisplayName}" />
                                    <TextBlock Opacity="0.58" Text="{Binding SubjectDisplayName}" />
                                    <TextBlock Opacity="0.58" Text="{Binding DueLabel}" />
                                </StackPanel>
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="重新确认尚未确认的学情问题提交"
                                Click="RetryPendingLearningCase_Click"
                                Content="重新确认"
                                Tag="{Binding Request}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ListView
            Grid.Row="2"
            AutomationProperties.AutomationId="TodayActionList"
            ItemsSource="{Binding TodayActions}"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,10,8,12" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding BucketLabel}" />
                            <TextBlock FontSize="12" Opacity="0.62" Text="{Binding DueLabel}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,20,0" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Opacity="0.72" Text="{Binding StudentDisplayName}" />
                            <TextBlock FontSize="12" Opacity="0.62" Text="{Binding InteractionStateLabel}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Opacity="0.72"
                            Text="{Binding Subject}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
