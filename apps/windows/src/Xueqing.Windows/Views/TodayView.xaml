<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xueqing.Windows.Views.TodayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Padding="28,20,28,24"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                AutomationProperties.AutomationId="TodayHeading"
                FontSize="28"
                FontWeight="SemiBold"
                Text="今日" />
            <TextBlock
                AutomationProperties.AutomationId="TodaySurface"
                Opacity="0.68"
                Text="明确的待办教学行动，而不是未关闭问题的统计面板" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            AutomationProperties.AutomationId="TodayActionList"
            ItemsSource="{Binding TodayActions}"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="4,10,8,12" MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding BucketLabel}" />
                            <TextBlock FontSize="12" Opacity="0.62" Text="{Binding DueLabel}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,20,0" Spacing="3">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Opacity="0.72" Text="{Binding StudentDisplayName}" />
                            <TextBlock FontSize="12" Opacity="0.62" Text="{Binding SaveStateLabel}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Opacity="0.72"
                            Text="{Binding Subject}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
