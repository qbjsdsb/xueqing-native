<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xueqing.Windows.Views.LearningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,20,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            AutomationProperties.AutomationId="LearningSurface"
            FontSize="28"
            FontWeight="SemiBold"
            Text="学情" />

        <Grid Grid.Row="1">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding IsAuthoritativeStudentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel
                    MaxWidth="860"
                    HorizontalAlignment="Left"
                    Spacing="20">

                    <StackPanel Spacing="3">
                        <TextBlock
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedStudent.DisplayName}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Opacity="0.66"
                            Text="{Binding SelectedTeachingContext.DisplayName}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="当前关注" />
                        <TextBlock
                            Opacity="0.62"
                            Text="{Binding CurrentFocusStatusText}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding CurrentFocus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8,0,10" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock Opacity="0.72" Text="{Binding NextAction}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock HorizontalAlignment="Right" Opacity="0.72" Text="{Binding StateLabel}" />
                                            <TextBlock HorizontalAlignment="Right" FontSize="12" Opacity="0.58" Text="{Binding DueLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                    <StackPanel Spacing="8">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="最近观察" />
                        <TextBlock
                            Opacity="0.62"
                            Text="{Binding RecentObservationsStatusText}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding RecentObservations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,7,0,9" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.66" Text="●" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock FontWeight="SemiBold" Text="课堂观察" />
                                            <TextBlock Text="{Binding RawText}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="12" Opacity="0.58" Text="{Binding CreatedAtServer}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Opacity="0.58" Text="{Binding RecentHistoryMoreText}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid
                Visibility="{Binding IsAuthoritativeStudentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel MaxWidth="860" HorizontalAlignment="Left" Spacing="8">
                    <TextBlock FontSize="12" Opacity="0.62" Text="测试案例" />
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{Binding LearningCase.Title}"
                        TextWrapping="Wrap" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding LearningCase.StudentDisplayName}" />
                        <Run Text=" · " />
                        <Run Text="{Binding LearningCase.Subject}" />
                        <Run Text=" · " />
                        <Run Text="{Binding LearningCase.StateLabel}" />
                    </TextBlock>
                    <TextBlock Opacity="0.72" Text="{Binding LearningCase.ResponsibleTeacher}" />
                    <StackPanel Margin="0,10,0,2" Spacing="4">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="下一步" />
                        <TextBlock Text="{Binding LearningCase.NextAction}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    Margin="0,16,0,0"
                    MaxWidth="860"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="LearningTimeline"
                    ItemsSource="{Binding LearningCase.Timeline}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,10,8,14" MinHeight="72">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="12" Opacity="0.62" Text="{Binding DateLabel}" TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="5">
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="12" Opacity="0.62" Text="{Binding ActorDisplayName}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
