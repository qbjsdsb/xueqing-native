<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Xueqing.Windows.Views.StudentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="F"
            Modifiers="Control"
            Invoked="FocusStudentSearch_Invoked" />
        <KeyboardAccelerator
            Key="Left"
            Modifiers="Menu"
            Invoked="BackToStudentList_Invoked" />
    </UserControl.KeyboardAccelerators>

    <Grid
        x:Name="WorkspaceGrid"
        Padding="20,16,24,20"
        ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="ListPane"
            RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    AutomationProperties.AutomationId="StudentHeading"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="学生" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,6,4,0"
                    Opacity="0.58"
                    Text="{Binding Students.Count}" />
            </Grid>

            <TextBox
                x:Name="SearchBox"
                Grid.Row="1"
                AutomationProperties.AutomationId="StudentSearchBox"
                AutomationProperties.Name="搜索学生"
                IsEnabled="{Binding IsStartupUnavailable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                PlaceholderText="{Binding SearchPlaceholderText}"
                TextChanged="SearchBox_TextChanged" />

            <ListView
                x:Name="StudentList"
                Grid.Row="2"
                AutomationProperties.AutomationId="StudentList"
                AutomationProperties.Name="学生列表"
                IsItemClickEnabled="True"
                ItemClick="StudentList_ItemClick"
                ItemsSource="{Binding Students}"
                KeyDown="StudentList_KeyDown"
                SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                SelectionChanged="StudentList_SelectionChanged"
                SelectionMode="Single"
                Visibility="{Binding IsStartupUnavailable, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6,8,8,9" MinHeight="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Opacity="0.62"
                                    Text="{Binding SecondaryLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                HorizontalAlignment="Right"
                                Spacing="2">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Opacity="0.82"
                                    Text="{Binding PrimarySubject}" />
                                <TextBlock
                                    FontSize="12"
                                    HorizontalAlignment="Right"
                                    Opacity="0.54"
                                    Text="{Binding ActiveCaseCountLabel}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Grid.Row="2"
                Margin="4,18,12,0"
                AutomationProperties.AutomationId="StudentWorkspaceUnavailable"
                FontSize="14"
                Opacity="0.68"
                Text="{Binding StartupStatusText}"
                TextWrapping="Wrap"
                Visibility="{Binding IsStartupUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Keep a stable visible surface marker for UIA even as the visual
                 heading becomes more compact in the v2 reference layout. -->
            <TextBlock
                Grid.Row="0"
                AutomationProperties.AutomationId="StudentsSurface"
                IsHitTestVisible="False"
                Opacity="0"
                Text="学生工作区" />
        </Grid>

        <Grid
            x:Name="DetailPane"
            Grid.Column="1"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                x:Name="BackToListButton"
                Margin="0,0,0,12"
                HorizontalAlignment="Left"
                AutomationProperties.AutomationId="BackToStudentList"
                Click="BackToListButton_Click"
                Content="返回学生列表"
                Visibility="Collapsed" />

            <ScrollViewer
                x:Name="DetailScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Width="{Binding ViewportWidth, ElementName=DetailScrollViewer}"
                    MaxWidth="860"
                    HorizontalAlignment="Left"
                    Spacing="20">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock
                                AutomationProperties.AutomationId="StudentDetailHeading"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedStudent.DisplayName}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Opacity="0.66"
                                Text="{Binding SelectedStudent.PrimarySubject}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="RefreshAuthoritativeStudents"
                            AutomationProperties.Name="刷新任教学员与最近记录"
                            Click="RefreshAuthoritativeStudents_Click"
                            Content="刷新"
                            Visibility="{Binding IsAuthoritativeStudentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <StackPanel
                        Spacing="20"
                        Visibility="{Binding IsPrototypeMode, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <StackPanel Spacing="10">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="正在关注" />

                            <Grid Padding="0,4,0,8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="阅读材料的信息关系组织仍需验证"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Opacity="0.65"
                                        Text="最近观察中，限制条件能够定位，但因果关系仍需要提示。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Opacity="0.68"
                                    Text="待验证" />
                            </Grid>

                            <Border
                                Height="1"
                                Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                            <Grid Padding="0,4,0,2" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="相同策略在短文本中能够独立使用"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Opacity="0.65"
                                        Text="迁移到更长的陌生材料时仍需继续观察。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Opacity="0.68"
                                    Text="跟进中" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="下一步" />
                            <Grid Padding="0,5,0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Top"
                                    FontSize="18"
                                    Opacity="0.72"
                                    Text="○" />
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="使用新的陌生材料验证迁移"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Opacity="0.62"
                                        Text="验证是否能够在新的阅读材料中独立组织信息关系。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="12,1,0,0"
                                    Opacity="0.62"
                                    Text="待安排" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="教学脉络" />
                                <TextBlock
                                    Grid.Column="1"
                                    Opacity="0.55"
                                    Text="测试数据" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Opacity="0.58" Text="9 月 17 日" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.76"
                                    Text="●" />
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="课堂观察" />
                                    <TextBlock
                                        Opacity="0.68"
                                        Text="能主动定位限制条件，但因果关系组织仍需要提示。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Opacity="0.58" Text="9 月 14 日" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.62"
                                    Text="●" />
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="干预" />
                                    <TextBlock
                                        Opacity="0.68"
                                        Text="重新示范信息之间的因果连接方式，并使用短文本练习。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Opacity="0.58" Text="9 月 10 日" />
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.48"
                                    Text="●" />
                                <StackPanel Grid.Column="2" Spacing="3">
                                    <TextBlock FontWeight="SemiBold" Text="验证" />
                                    <TextBlock
                                        Opacity="0.68"
                                        Text="相同策略在短文本中已经能够独立使用。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel
                        Spacing="16"
                        Visibility="{Binding IsAuthoritativeStudentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ComboBox
                            x:Name="SubjectContextBox"
                            AutomationProperties.AutomationId="StudentSubjectContext"
                            AutomationProperties.Name="选择任教学科"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding SelectedTeachingContexts}"
                            PlaceholderText="选择学科"
                            SelectedItem="{Binding SelectedTeachingContext, Mode=TwoWay}"
                            SelectionChanged="SubjectContextBox_SelectionChanged" />

                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="正在关注" />
                            <TextBlock
                                AutomationProperties.AutomationId="CurrentFocusStatus"
                                Opacity="0.62"
                                Text="{Binding CurrentFocusStatusText}"
                                TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding CurrentFocus}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,7,0,9" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Title}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Opacity="0.70"
                                                    Text="{Binding NextAction}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                HorizontalAlignment="Right"
                                                Spacing="2">
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Opacity="0.72"
                                                    Text="{Binding StateLabel}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="12"
                                                    Opacity="0.56"
                                                    Text="{Binding DueLabel}" />
                                                <Button
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Right"
                                                    Visibility="Collapsed"
                                                    AutomationProperties.Name="{Binding LifecycleAutomationName}"
                                                    Loaded="CaseLifecycleButton_Loaded"
                                                    Click="CaseLifecycle_Click"
                                                    Content="{Binding LifecycleActionLabel}"
                                                    Tag="{Binding}" />
                                                <StackPanel
                                                    Margin="0,4,0,0"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="6">
                                                    <Button
                                                        Visibility="Collapsed"
                                                        AutomationProperties.Name="调整当前关注的行动日期"
                                                        Loaded="RescheduleFocusActionButton_Loaded"
                                                        Click="RescheduleFocusAction_Click"
                                                        Content="改期"
                                                        Tag="{Binding}" />
                                                    <Button
                                                        Visibility="Collapsed"
                                                        AutomationProperties.Name="验证当前关注并安排下一步"
                                                        Loaded="VerifyFocusActionButton_Loaded"
                                                        Click="VerifyFocusAction_Click"
                                                        Content="验证"
                                                        Tag="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border
                            Height="1"
                            Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="全部 Case" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="LoadCaseHistory"
                                    AutomationProperties.Name="查看当前学科全部 Case"
                                    Click="LoadCaseHistory_Click"
                                    Content="查看全部" />
                            </Grid>

                            <TextBlock
                                AutomationProperties.AutomationId="CaseHistoryStatus"
                                Opacity="0.62"
                                Text="{Binding CaseHistoryStatusText}"
                                TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding CaseHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,7,0,9" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Title}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Opacity="0.68"
                                                    Text="{Binding NextAction}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                HorizontalAlignment="Right"
                                                Spacing="2">
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    Opacity="0.72"
                                                    Text="{Binding StateLabel}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="12"
                                                    Opacity="0.56"
                                                    Text="{Binding ResponsibilityLabel}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="12"
                                                    Opacity="0.56"
                                                    Text="{Binding DueLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Opacity="0.56"
                                Text="{Binding CaseHistoryMoreText}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Height="1"
                            Background="{ThemeResource SystemControlForegroundBaseLowBrush}" />

                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="最近观察" />
                            <TextBlock
                                AutomationProperties.AutomationId="RecentObservationStatus"
                                Opacity="0.66"
                                Text="{Binding RecentObservationsStatusText}"
                                TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{Binding RecentObservations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,7,0,9" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Opacity="0.66"
                                                Text="●" />
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Text="课堂观察" />
                                                <TextBlock
                                                    Text="{Binding RawText}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Opacity="0.58"
                                                    Text="{Binding CreatedAtServer}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="2"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Top"
                                                AutomationProperties.Name="从这条课堂观察形成学情问题"
                                                Loaded="CreateLearningCaseButton_Loaded"
                                                Click="CreateLearningCase_Click"
                                                Content="形成学情问题"
                                                Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                Opacity="0.58"
                                Text="{Binding RecentHistoryMoreText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
